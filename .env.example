# Copy to .env (never commit .env). Only one of these is needed.
GROQ_API_KEY=            # https://console.groq.com -> API Keys (free tier)
# OPENAI_API_KEY=        # any OpenAI compatible server, with FORGE_BACKEND=openai and FORGE_BASE_URL
# OLLAMA_HOST=http://localhost:11434   # fully local: FORGE_BACKEND=ollama

# Optional overrides (otherwise forgeai.yaml / demos/demo_config.yaml)
# FORGE_BACKEND=groq
# FORGE_MODEL=openai/gpt-oss-20b
# FORGE_JUDGE_MODEL=qwen/qwen3.8-27b
# FORGE_EMBEDDING=wordllama        # or fastembed:BAAI/bge-small-en-v1.5
# FORGE_CONFIG=demos/demo_config.yaml
